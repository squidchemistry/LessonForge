PORT=4000
# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
# Comma-separated fallback chain; first model is tried first.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# https://tavily.com  (free tier, ~1000 credits/month)
TAVILY_API_KEY=
# Google Cloud Console -> enable "YouTube Data API v3" -> create API key (free quota)
YOUTUBE_API_KEY=
# Optional: protect the whole app with a login (HTTP Basic auth). Recommended when deployed; leave empty locally.
# Username defaults to "admin" when APP_PASSWORD is set.
APP_USERNAME=
APP_PASSWORD=
# Optional: PostgreSQL connection string (e.g. free Neon: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require).
# When set, lessons are stored in Postgres and survive restarts/redeploys. When empty, JSON files in server/data are used.
DATABASE_URL=
# Optional (file storage only): where JSON files are stored (default server/data).
DATA_DIR=
